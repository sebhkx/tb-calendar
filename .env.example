# Supabase Postgres — Project Settings → Database → Connection string (URI, direct, port 5432)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres

# Set to true for hosted Postgres that requires SSL (Supabase always needs this)
DB_SSL=true

# Supabase client keys (for future auth / realtime / mobile SDK)
# NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
